import streamlit as st
import sqlite3
from datetime import datetime
from email.message import EmailMessage
import smtplib

# --- SETTINGS ---
DB = "laundry.db"
EMAIL_ADDRESS = "laundrysocials2024@gmail.com"       
EMAIL_PASSWORD = "your_app_password_here"            
OPS_EMAIL = "lscommercial01@gmail.com"              
DELIVERY_EMAIL = "lscommercial02@gmail.com"          

# --- DATABASE SETUP ---
def create_tables():
    conn = sqlite3.connect(DB)
    cursor = conn.cursor()
    cursor.execute('''
        CREATE TABLE IF NOT EXISTS Orders (
            id INTEGER PRIMARY KEY AUTOINCREMENT,
            customer_name TEXT,
            status TEXT,
            delivery_date TEXT
        )
    ''')
    conn.commit()
    conn.close()

# --- EMAIL ---
def send_email(to, subject, message):
    try:
        msg = EmailMessage()
        msg['Subject'] = subject
        msg['From'] = EMAIL_ADDRESS
        msg['To'] = to
        msg.set_content(message)

        with smtplib.SMTP_SSL('smtp.gmail.com', 465) as smtp:
            smtp.login(EMAIL_ADDRESS, EMAIL_PASSWORD)
            smtp.send_message(msg)
        print(f"Email sent to {to}")
    except Exception as e:
        print(f"Error sending email: {e}")

# --- DATABASE UTILS ---
def update_status(order_id, new_status):
    conn = sqlite3.connect(DB)
    cursor = conn.cursor()
    cursor.execute("UPDATE Orders SET status = ? WHERE id = ?", (new_status, order_id))
    conn.commit()
    conn.close()

    if new_status == "Picked Up":
        send_email(OPS_EMAIL, "Laundry Picked Up", f"Order #{order_id} has been picked up.")
    elif new_status == "Ready":
        send_email(DELIVERY_EMAIL, "Laundry Ready", f"Order #{order_id} is ready for delivery.")

def get_orders_for_today():
    today = datetime.today().date()
    conn = sqlite3.connect(DB)
    cursor = conn.cursor()
    cursor.execute("SELECT id, customer_name, delivery_date, status FROM Orders WHERE status != 'Delivered'")
    orders = cursor.fetchall()
    conn.close()

    due_orders = []
    for order in orders:
        delivery_date = datetime.strptime(order[2], "%Y-%m-%d").date()
        if delivery_date == today:
            due_orders.append(order)
    return due_orders

def add_order(customer_name, delivery_date):
    conn = sqlite3.connect(DB)
    cursor = conn.cursor()
    cursor.execute("INSERT INTO Orders (customer_name, delivery_date, status) VALUES (?, ?, ?)",
                   (customer_name, delivery_date, "Created"))
    conn.commit()
    conn.close()

# --- UI ---
create_tables()
st.title("🧺 Laundry Delivery Tracker")

role = st.radio("Select Role", ["Delivery Associate", "Operations", "Add New Order", "View Today's Deliveries"])

if role == "Delivery Associate":
    st.subheader("📦 Mark Laundry as Picked Up")
    order_id = st.number_input("Enter Order ID", step=1)
    if st.button("Mark as Picked Up"):
        update_status(order_id, "Picked Up")
        st.success(f"Order #{order_id} marked as Picked Up.")

elif role == "Operations":
    st.subheader("🛠️ Mark Laundry as Ready")
    order_id = st.number_input("Enter Order ID", step=1)
    if st.button("Mark as Ready for Delivery"):
        update_status(order_id, "Ready")
        st.success(f"Order #{order_id} marked as Ready.")

elif role == "Add New Order":
    st.subheader("➕ Add Laundry Order")
    name = st.text_input("Customer Name")
    delivery = st.date_input("Delivery Date", min_value=datetime.today())
    if st.button("Create Order"):
        add_order(name, delivery.strftime("%Y-%m-%d"))
        st.success(f"Order for {name} scheduled for {delivery}")

elif role == "View Today's Deliveries":
    st.subheader("🚚 Deliveries Due Today")
    orders = get_orders_for_today()
    if orders:
        for o in orders:
            st.markdown(f"**Order #{o[0]} - {o[1]}** | Delivery Date: {o[2]} | Status: {o[3]}")
    else:
        st.info("No deliveries due today.")  # shows info if no deliveries found

